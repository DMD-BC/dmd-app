{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/beso",
      "destination": "https://www.dmdmx.dev/"
    },
    {
      "source": "/beso/:path*",
      "destination": "https://www.dmdmx.dev/:path*"
    },
    {
      "source": "/_next/:path*",
      "destination": "https://www.dmdmx.dev/_next/:path*"
    },
    {
      "source": "/samples/:path*",
      "destination": "https://www.dmdmx.dev/samples/:path*"
    }
  ]
}
