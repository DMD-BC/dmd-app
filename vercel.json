{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/beso",
      "destination": "https://beso-ia.vercel.app/"
    },
    {
      "source": "/beso/:path*",
      "destination": "https://beso-ia.vercel.app/:path*"
    },
    {
      "source": "/_next/:path*",
      "destination": "https://beso-ia.vercel.app/_next/:path*"
    },
    {
      "source": "/samples/:path*",
      "destination": "https://beso-ia.vercel.app/samples/:path*"
    }
  ]
}
